# Copy this file to .env.local and fill it in. NEVER commit .env.local.

# The password you type at /admin to upload photos.
ADMIN_PASSWORD=choose-a-long-password

# A long random string used to sign your login cookie. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Online storage (Supabase). Leave these two EMPTY while developing on your own
# computer: photos are then saved in the local .data folder instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
